{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solana-idl/idl-spec/schema/v1.0.0.json",
  "title": "Solana IDL v1.0.0",
  "description": "JSON Schema for Solana program Interface Description Language (IDL) files, spec version 1.0.0.",
  "$ref": "#/$defs/Idl",

  "$defs": {
    "Idl": {
      "type": "object",
      "required": ["address", "metadata", "instructions"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "address": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata/IdlMetadata" },
        "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "instructions": { "type": "array", "items": { "$ref": "#/$defs/instruction/IdlInstruction" } },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/IdlAccount" }, "default": [] },
        "events": { "type": "array", "items": { "$ref": "#/$defs/IdlEvent" }, "default": [] },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/IdlErrorCode" }, "default": [] },
        "types": { "type": "array", "items": { "$ref": "#/$defs/types/IdlTypeDef" }, "default": [] },
        "pdas": { "type": "array", "items": { "$ref": "#/$defs/pda/IdlPda" }, "default": [] },
        "additionalPrograms": { "type": "array", "items": { "$ref": "#/$defs/Idl" }, "default": [] }
      }
    },

    "metadata": {
      "IdlMetadata": {
        "type": "object",
        "required": ["name", "version", "spec", "generator"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "spec": { "type": "string", "const": "1.0.0" },
          "generator": { "$ref": "#/$defs/metadata/IdlGenerator" },
          "description": { "type": "string" },
          "repository": { "type": "string" },
          "contact": { "type": "string" },
          "dependencies": { "type": "array", "items": { "$ref": "#/$defs/metadata/IdlDependency" }, "default": [] },
          "deployments": { "$ref": "#/$defs/metadata/IdlDeployments" }
        }
      },
      "IdlGenerator": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "IdlDependency": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "IdlDeployments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mainnet": { "type": "string" },
          "testnet": { "type": "string" },
          "devnet": { "type": "string" },
          "localnet": { "type": "string" }
        }
      }
    },

    "instruction": {
      "IdlInstruction": {
        "type": "object",
        "required": ["name", "discriminators", "accounts"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
          "discriminators": {
            "type": "array",
            "items": { "$ref": "#/$defs/discriminator/IdlDiscriminator" },
            "minItems": 1
          },
          "accounts": { "type": "array", "items": { "$ref": "#/$defs/instruction/IdlInstructionAccount" } },
          "args": { "type": "array", "items": { "$ref": "#/$defs/instruction/IdlInstructionArg" }, "default": [] },
          "returns": { "$ref": "#/$defs/types/IdlType" },
          "remainingAccounts": {
            "type": "array",
            "items": { "$ref": "#/$defs/instruction/IdlRemainingAccountsEntry" }
          },
          "preInstructions": { "type": "array", "items": { "$ref": "#/$defs/instruction/IdlPrePostIx" }, "default": [] },
          "postInstructions": { "type": "array", "items": { "$ref": "#/$defs/instruction/IdlPrePostIx" }, "default": [] },
          "optionalAccountStrategy": {
            "type": "string",
            "enum": ["omitted", "programId"],
            "default": "omitted"
          },
          "byteDeltas": {
            "type": "array",
            "items": { "$ref": "#/$defs/instruction/IdlByteDelta" },
            "default": []
          },
          "subInstructions": {
            "type": "array",
            "items": { "$ref": "#/$defs/instruction/IdlInstruction" },
            "default": []
          }
        }
      },
      "IdlByteDelta": {
        "type": "object",
        "required": ["value"],
        "additionalProperties": false,
        "properties": {
          "value": { "$ref": "#/$defs/values/IdlDefaultValue" },
          "withHeader": { "type": "boolean", "default": false },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "IdlInstructionAccount": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
          "writable": { "type": "boolean", "default": false },
          "signer": { "type": "boolean", "default": false },
          "signerOptional": { "type": "boolean", "default": false },
          "messageSigner": { "$ref": "#/$defs/instruction/IdlMessageSigner" },
          "optional": { "type": "boolean", "default": false },
          "address": { "$ref": "#/$defs/expressions/IdlAddressExpression" },
          "default": { "$ref": "#/$defs/values/IdlDefaultValue" },
          "group": { "type": "string" },
          "expiresAt": { "$ref": "#/$defs/expressions/IdlPathExpression" }
        },
        "allOf": [
          {
            "if": { "required": ["messageSigner"] },
            "then": { "required": ["expiresAt"] }
          },
          {
            "not": {
              "allOf": [
                { "properties": { "signer": { "const": true } }, "required": ["signer"] },
                { "required": ["messageSigner"] }
              ]
            }
          }
        ]
      },
      "IdlInstructionArg": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
          "type": { "$ref": "#/$defs/types/IdlType" },
          "default": { "$ref": "#/$defs/values/IdlDefaultValue" },
          "defaultValueStrategy": {
            "type": "string",
            "enum": ["omitted", "optional"],
            "default": "omitted"
          }
        }
      },
      "IdlRemainingAccountsEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": { "$ref": "#/$defs/values/IdlDefaultValue" },
          "writable": { "type": "boolean", "default": false },
          "signer": { "type": "boolean", "default": false },
          "signerOptional": { "type": "boolean", "default": false },
          "optional": { "type": "boolean", "default": false },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "IdlPrePostIx": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "mint", "owner", "payer"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "createAtaIdempotent" },
              "mint": { "$ref": "#/$defs/expressions/IdlAddressExpression" },
              "owner": { "$ref": "#/$defs/expressions/IdlAddressExpression" },
              "payer": { "$ref": "#/$defs/expressions/IdlAddressExpression" }
            }
          }
        ]
      },
      "IdlMessageSigner": {
        "type": "object",
        "required": ["template", "placeholders"],
        "additionalProperties": false,
        "properties": {
          "template": { "type": "string" },
          "placeholders": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/instruction/IdlMessageSignerPlaceholder" }
          }
        }
      },
      "IdlMessageSignerPlaceholder": {
        "type": "object",
        "required": ["from"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/expressions/IdlPathExpression" },
          "format": { "$ref": "#/$defs/formats/IdlSemanticFormat" }
        }
      }
    },

    "IdlAccount": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "data": { "$ref": "#/$defs/types/IdlTypeStruct" },
        "discriminators": {
          "type": "array",
          "items": { "$ref": "#/$defs/discriminator/IdlDiscriminator" }
        },
        "pda": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },

    "IdlEvent": {
      "type": "object",
      "required": ["name", "data", "discriminators"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "data": { "$ref": "#/$defs/types/IdlTypeStruct" },
        "discriminators": {
          "type": "array",
          "items": { "$ref": "#/$defs/discriminator/IdlDiscriminator" },
          "minItems": 1
        }
      }
    },

    "IdlErrorCode": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "message": { "type": "string" },
        "docs": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },

    "discriminator": {
      "IdlDiscriminator": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "bytes"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "constant" },
              "bytes": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0, "maximum": 255 }
              },
              "offset": { "type": "integer", "minimum": 0, "default": 0 }
            }
          },
          {
            "type": "object",
            "required": ["type", "path"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "field" },
              "path": { "type": "string" },
              "offset": { "type": "integer", "minimum": 0 },
              "value": {}
            }
          },
          {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "size" },
              "value": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      }
    },

    "types": {
      "IdlType": {
        "oneOf": [
          { "$ref": "#/$defs/types/IdlPrimitive" },
          { "$ref": "#/$defs/types/IdlTypeNumber" },
          { "$ref": "#/$defs/types/IdlTypeBoolean" },
          { "$ref": "#/$defs/types/IdlTypeOption" },
          { "$ref": "#/$defs/types/IdlTypeArray" },
          { "$ref": "#/$defs/types/IdlTypeString" },
          { "$ref": "#/$defs/types/IdlTypeBytes" },
          { "$ref": "#/$defs/types/IdlTypeMap" },
          { "$ref": "#/$defs/types/IdlTypeSet" },
          { "$ref": "#/$defs/types/IdlTypeTuple" },
          { "$ref": "#/$defs/types/IdlTypeStruct" },
          { "$ref": "#/$defs/types/IdlTypeDefined" },
          { "$ref": "#/$defs/types/IdlTypeGeneric" },
          { "$ref": "#/$defs/types/IdlTypeSemantic" },
          { "$ref": "#/$defs/types/IdlTypePadding" },
          { "$ref": "#/$defs/types/IdlTypeFixedSize" },
          { "$ref": "#/$defs/types/IdlTypeHiddenPrefix" },
          { "$ref": "#/$defs/types/IdlTypeHiddenSuffix" },
          { "$ref": "#/$defs/types/IdlTypePreOffset" },
          { "$ref": "#/$defs/types/IdlTypePostOffset" },
          { "$ref": "#/$defs/types/IdlTypeSentinel" },
          { "$ref": "#/$defs/types/IdlTypeZeroableOption" },
          { "$ref": "#/$defs/types/IdlTypeRemainderOption" },
          { "$ref": "#/$defs/types/IdlTypeSizePrefix" }
        ]
      },
      "IdlPrimitive": {
        "type": "string",
        "enum": [
          "bool",
          "u8", "i8", "u16", "i16", "u32", "i32",
          "u64", "i64", "u128", "i128", "u256", "i256",
          "f32", "f64",
          "shortU16",
          "pubkey",
          "bytes",
          "string"
        ]
      },
      "IdlTypeNumber": {
        "type": "object",
        "required": ["type", "format"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "number" },
          "format": {
            "type": "string",
            "enum": [
              "u8", "i8", "u16", "i16", "u32", "i32",
              "u64", "i64", "u128", "i128", "u256", "i256",
              "f32", "f64",
              "shortU16"
            ]
          },
          "endian": { "type": "string", "enum": ["le", "be"], "default": "le" }
        }
      },
      "IdlTypeOption": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "option" },
          "value": { "$ref": "#/$defs/types/IdlType" }
        }
      },
      "IdlTypeArray": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "array" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "count": { "$ref": "#/$defs/types/IdlArrayCount" }
        }
      },
      "IdlTypeString": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "string" },
          "encoding": { "type": "string", "enum": ["utf8", "base58", "base64"], "default": "utf8" },
          "count": { "$ref": "#/$defs/types/IdlArrayCount" }
        }
      },
      "IdlTypeBytes": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "bytes" },
          "count": { "$ref": "#/$defs/types/IdlArrayCount" }
        }
      },
      "IdlTypeMap": {
        "type": "object",
        "required": ["type", "key", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "map" },
          "key": { "$ref": "#/$defs/types/IdlType" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "count": { "$ref": "#/$defs/types/IdlArrayCount" }
        }
      },
      "IdlTypeSet": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "set" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "count": { "$ref": "#/$defs/types/IdlArrayCount" }
        }
      },
      "IdlTypeTuple": {
        "type": "object",
        "required": ["type", "elements"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "tuple" },
          "elements": { "type": "array", "items": { "$ref": "#/$defs/types/IdlType" } }
        }
      },
      "IdlTypeStruct": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "struct" },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/types/IdlField" }, "default": [] }
        }
      },
      "IdlTypeDefined": {
        "type": "object",
        "required": ["type", "name"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "defined" },
          "name": { "type": "string" },
          "program": { "type": "string" },
          "generics": { "type": "array", "items": { "$ref": "#/$defs/types/IdlGenericArg" }, "default": [] }
        }
      },
      "IdlTypeGeneric": {
        "type": "object",
        "required": ["type", "name"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "generic" },
          "name": { "type": "string" }
        }
      },
      "IdlTypeSemantic": {
        "type": "object",
        "required": ["type", "inner", "format"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "semantic" },
          "inner": { "$ref": "#/$defs/types/IdlType" },
          "format": { "$ref": "#/$defs/formats/IdlSemanticFormat" }
        }
      },
      "IdlTypePadding": {
        "type": "object",
        "required": ["type", "bytes"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "padding" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      },
      "IdlTypeBoolean": {
        "type": "object",
        "required": ["type", "size"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "boolean" },
          "size": { "$ref": "#/$defs/types/IdlTypeNumber" }
        }
      },
      "IdlTypeFixedSize": {
        "type": "object",
        "required": ["type", "value", "size"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "fixedSize" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "size": { "type": "integer", "minimum": 0 }
        }
      },
      "IdlTypeHiddenPrefix": {
        "type": "object",
        "required": ["type", "value", "prefix"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "hiddenPrefix" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "prefix": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      },
      "IdlTypeHiddenSuffix": {
        "type": "object",
        "required": ["type", "value", "suffix"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "hiddenSuffix" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "suffix": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      },
      "IdlTypePreOffset": {
        "type": "object",
        "required": ["type", "value", "offset"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "preOffset" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "offset": { "type": "integer" },
          "strategy": {
            "type": "string",
            "enum": ["padded", "absolute", "preOffset"],
            "default": "padded"
          }
        }
      },
      "IdlTypePostOffset": {
        "type": "object",
        "required": ["type", "value", "offset"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "postOffset" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "offset": { "type": "integer" },
          "strategy": {
            "type": "string",
            "enum": ["padded", "absolute", "preOffset"],
            "default": "padded"
          }
        }
      },
      "IdlTypeSentinel": {
        "type": "object",
        "required": ["type", "value", "sentinel"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "sentinel" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "sentinel": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "minItems": 1
          }
        }
      },
      "IdlTypeZeroableOption": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "zeroableOption" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "zeroValue": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      },
      "IdlTypeRemainderOption": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "remainderOption" },
          "value": { "$ref": "#/$defs/types/IdlType" }
        }
      },
      "IdlTypeSizePrefix": {
        "type": "object",
        "required": ["type", "value", "prefix"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "sizePrefix" },
          "value": { "$ref": "#/$defs/types/IdlType" },
          "prefix": { "$ref": "#/$defs/types/IdlTypeNumber" }
        }
      },
      "IdlArrayCount": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "prefix"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "prefixed" },
              "prefix": { "type": "string", "enum": ["u8", "u16", "u32", "u64", "shortU16"] }
            }
          },
          {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "fixed" },
              "value": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "remainder" }
            }
          }
        ]
      },
      "IdlField": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "$ref": "#/$defs/types/IdlType" },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "IdlTypeDef": {
        "type": "object",
        "required": ["name", "shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "docs": { "type": "array", "items": { "type": "string" }, "default": [] },
          "generics": {
            "type": "array",
            "items": { "$ref": "#/$defs/types/IdlTypeDefGeneric" },
            "default": []
          },
          "shape": { "$ref": "#/$defs/types/IdlTypeDefShape" }
        }
      },
      "IdlTypeDefShape": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "const": "struct" },
              "fields": { "type": "array", "items": { "$ref": "#/$defs/types/IdlField" }, "default": [] }
            }
          },
          {
            "type": "object",
            "required": ["kind", "variants"],
            "additionalProperties": false,
            "properties": {
              "kind": { "const": "enum" },
              "variants": { "type": "array", "items": { "$ref": "#/$defs/types/IdlEnumVariant" } },
              "size": { "$ref": "#/$defs/types/IdlTypeNumber" }
            }
          },
          {
            "type": "object",
            "required": ["kind", "alias"],
            "additionalProperties": false,
            "properties": {
              "kind": { "const": "alias" },
              "alias": { "$ref": "#/$defs/types/IdlType" }
            }
          }
        ]
      },
      "IdlEnumVariant": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
